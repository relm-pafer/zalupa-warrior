diff --git a/index.html b/index.html
index ee8dcd8..dea6e14 100644
--- a/index.html
+++ b/index.html
@@ -410,6 +410,34 @@ button{font:inherit}
 .v-koska .mouth{left:24px; top:34px; width:11px; height:5px; rotate:-4deg; border-radius:45% 45% 50% 50% / 40% 40% 60% 60%; background:linear-gradient(180deg, #c8102e 0 42%, #6e0a1a 42% 56%, #e2345a 56%)}
 .hero.grab.v-koska .mouth{top:33px; height:6px; background:#3a1a14; box-shadow:inset 0 0 0 1.6px #d1153a, inset 4px 0 0 var(--gold)}
 
+/* ---------- photo faces: an inmate with a face photo (CHARS[id].face) becomes a bobblehead ---------- */
+/* Every faces/*.webp is framed the same way (160×184, eyes level and centred at y 104, 40 px apart),
+   so one box fits them all: eyes land at y 18 of the rig and the chin overlaps the neck. */
+.photo .rig .head{
+  left:21px; top:-21px; width:60px; height:69px; overflow:visible; border-radius:0;
+  background:var(--face) center / 100% 100% no-repeat;
+  transform-origin:30px 62px;
+  filter:drop-shadow(0 2px 1.5px rgba(50,25,15,.35));
+}
+.photo .rig .head > *, .photo .rig .head::after, .photo .rig .ear, .photo .rig .nose, .photo .rig .hair-top{display:none}
+.photo .rig .hardhat{top:-26px; transform-origin:26px 67px}
+.photo .rig .hair-top{transform-origin:19px 50px}
+.hero.photo.running .head, .hero.photo.running .hardhat, .hero.photo.running .hair-top{animation:bobble .34s ease-in-out infinite alternate}
+@keyframes bobble{from{rotate:-6deg} to{rotate:6deg}}
+.hero.photo.grab .head, .hero.photo.grab .hardhat, .hero.photo.grab .hair-top{animation:gulp .55s ease-out}
+@keyframes gulp{30%{scale:1.14}}
+.hero.photo.oops .head{animation:ouch .5s ease-out}
+@keyframes ouch{25%{filter:drop-shadow(0 2px 1.5px rgba(50,25,15,.35)) sepia(.8) saturate(4) hue-rotate(-30deg)}}
+.suspect-fig .figure.photo{top:28px}
+.mug-report .figure.photo{top:34px}
+/* Riki's face is cut tight to the face, so his long hair hangs down both sides with a fringe on top */
+.v-riki.photo .rig .hair-back{z-index:-1; left:23px; top:-4px; width:56px; height:84px; transform-origin:50% 5%}
+.v-riki.photo .rig .hair-top{display:block; left:32px; top:-9px; width:39px; height:15px; border-radius:55% 55% 30% 30% / 90% 90% 25% 25%}
+/* Mällu: suds and the whistle move clear of his bigger head; the drawn wisps go */
+.v-mallu.photo .rig .wisps, .v-mallu.photo .rig .mpb, .v-mallu.photo .rig .bags{display:none}
+.v-mallu.photo .rig .head-suds{top:-32px; left:29px}
+.v-mallu.photo .rig .whistle{left:74px; top:30px}
+
 /* ---------- Mällu, the block boss: same rig, skinny and shifty ---------- */
 .v-mallu{--skin:#e6b796; --skin-hi:#f5d2b6; --skin-shade:#c4906d; --skin-deep:#a0704f; --hair:#6b5137}
 .rig .ribs, .rig .tat-cat, .rig .mpb, .rig .wisps, .rig .bags, .rig .towel, .rig .head-suds, .rig .whistle{display:none}
@@ -735,12 +763,69 @@ button{font:inherit}
 .stats dt{font:700 10px/1.15 var(--font-type); letter-spacing:.12em; text-transform:uppercase}
 .stats dd{margin:0; font:700 22px/1 var(--font-type); font-variant-numeric:tabular-nums}
 
+/* ---------- leaderboard: the block's roster on a letterboard ---------- */
+.start-actions .btn.ghost{flex:1 1 0}
+.logbook{display:grid; gap:8px; padding-top:12px; border-top:2px dashed rgba(28,33,36,.35)}
+.logbook-head{display:flex; justify-content:space-between; align-items:baseline; gap:10px}
+.link-btn{padding:0; border:0; background:none; color:var(--ink); cursor:pointer; touch-action:manipulation; font:700 13px/1.2 var(--font-type); text-decoration:underline; text-underline-offset:3px}
+.link-btn:focus-visible{outline:3px solid var(--ink); outline-offset:2px}
+.lb-status{font-size:14px; line-height:1.4}
+.lb-status:empty{display:none}
+.lb{
+  list-style:none; margin:0; padding:5px; display:grid; gap:2px;
+  color:var(--board-text); background-color:var(--board);
+  background-image:repeating-linear-gradient(180deg, rgba(255,255,255,.04) 0 4px, rgba(0,0,0,.35) 4px 5px);
+  border:3px solid var(--board-edge); border-radius:6px;
+}
+.lb:empty{display:none}
+.lb.loading{opacity:.55; transition:opacity .2s .15s}
+.lb-row{display:grid; grid-template-columns:2.1em minmax(0, 1fr) auto auto; align-items:center; gap:8px; padding:5px 8px 4px; border-radius:3px; font:700 15px/1.25 var(--font-type)}
+.lb-rank{font-variant-numeric:tabular-nums; opacity:.65}
+.lb-row[data-rank="1"] .lb-rank{opacity:1; color:var(--gold)}
+.lb-row[data-rank="2"] .lb-rank{opacity:1; color:#d7dde0}
+.lb-row[data-rank="3"] .lb-rank{opacity:1; color:#e0a070}
+.lb-name{overflow:hidden; text-overflow:ellipsis; white-space:nowrap}
+.lb-char{grid-column:3; padding:3px 5px 2px; border-radius:3px; font:11px/1 var(--font-display); letter-spacing:.06em; text-transform:uppercase; color:var(--ink); background:var(--manila)}
+.lb-char[data-char="zen"]{background:#ffd23f}
+.lb-char[data-char="riki"]{color:#f4f4f0; background:#7a5638}
+.lb-char[data-char="koska"]{color:#fff; background:#d1153a}
+.lb-hide-char .lb-char{display:none}
+.lb-score{grid-column:4; min-width:5ch; text-align:right; font-variant-numeric:tabular-nums}
+.lb-row.me{color:var(--ink); background:var(--jumpsuit)}
+.lb-row.me .lb-rank{opacity:1; color:inherit}
+.lb-gap{padding:0 0 2px; text-align:center; letter-spacing:.4em; opacity:.45; line-height:.9}
+#boardScreen .sheet{grid-template-columns:minmax(0, 1fr)}
+.tabs{display:flex; flex-wrap:wrap; gap:6px}
+.tab{
